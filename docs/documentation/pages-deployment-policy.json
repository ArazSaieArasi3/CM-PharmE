  "v2_trigger_bridge": {
    "workflow_name": "CM-PharmE 2.0 Formal Ontology CI",
    "branch_pattern": "v2/**",
    "rule": "A successful V2 semantic-CI completion may request a Pages candidate build only when its head SHA already equals the V2 exact source SHA in the main-branch version registry. Otherwise Pages waits for the governed registry update on main."
