    "evidence_rules": [
      "Ratings must cite concrete pages/artifacts and observed patterns.",
      "A 5 requires complete and consistently executed evidence.",
      "A 4 is strong with bounded non-critical gaps.",
      "A 3 is adequate with material improvement opportunity.",
      "A 2 is partial and reader value is materially constrained.",
      "A 1 is weak/minimal; 0 is absent.",
      "Visual quality cannot score above 1 if no reader-facing diagrams are embedded.",
      "Scientific rigor may not be reduced to raise editorial/readability scores."
    ]
  },
  "anti_gaming_rules": [
    "Page count and word count are descriptive metrics, not quality by themselves.",
    "The same artifact must not be counted as full evidence for unrelated criteria without a stated reason.",
    "Diagram quantity cannot substitute for diagram correctness, notation or readability.",
    "Generated reference pages count only when linked, usable and subordinate to the authoritative semantic source.",
    "Pending/future work cannot receive completion points.",
    "A source-only artifact does not receive published/rendered completion credit where publication is part of the criterion."
