<?xml version='1.0' encoding='utf-8'?>
<RefOntoUML:Package xmlns:RefOntoUML="http://nemo.inf.ufes.br/ontouml/refontouml" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" xmi:id="pkg" name="UndefPhase-negative" visibility="public">
  <packagedElement xsi:type="RefOntoUML:Kind" xmi:id="Person" name="Person" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:Phase" xmi:id="PhaseA" name="PhaseA" visibility="public" isAbstract="false">
    <generalization xmi:id="PhaseAToPerson" general="Person" generalizationSet="Partition" />
  </packagedElement>
  <packagedElement xsi:type="RefOntoUML:Phase" xmi:id="PhaseB" name="PhaseB" visibility="public" isAbstract="false">
    <generalization xmi:id="PhaseBToPerson" general="Person" generalizationSet="Partition" />
  </packagedElement>
  <packagedElement xsi:type="RefOntoUML:DataType" xmi:id="Value" name="Value" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:Association" xmi:id="discriminator" name="discriminator" visibility="public" memberEnd="discriminatorA discriminatorB">
    <ownedEnd xmi:id="discriminatorA" name="discriminatorA" type="Person" association="discriminator" aggregation="none" visibility="public">
      <lowerValue xsi:type="RefOntoUML:LiteralInteger" xmi:id="discriminatorAlower" value="0" />
      <upperValue xsi:type="RefOntoUML:LiteralUnlimitedNatural" xmi:id="discriminatorAupper" value="1" />
    </ownedEnd>
    <ownedEnd xmi:id="discriminatorB" name="discriminatorB" type="Value" association="discriminator" aggregation="none" visibility="public">
      <lowerValue xsi:type="RefOntoUML:LiteralInteger" xmi:id="discriminatorBlower" value="0" />
      <upperValue xsi:type="RefOntoUML:LiteralUnlimitedNatural" xmi:id="discriminatorBupper" value="-1" />
    </ownedEnd>
  </packagedElement>
  <packagedElement xsi:type="RefOntoUML:GeneralizationSet" xmi:id="Partition" name="Partition" generalization="PhaseAToPerson PhaseBToPerson" isDisjoint="true" isCovering="true" />
</RefOntoUML:Package>