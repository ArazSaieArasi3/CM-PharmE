<?xml version='1.0' encoding='utf-8'?>
<RefOntoUML:Package xmlns:RefOntoUML="http://nemo.inf.ufes.br/ontouml/refontouml" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" xmi:id="pkg" name="UndefPhase-positive" visibility="public">
  <packagedElement xsi:type="RefOntoUML:Kind" xmi:id="Person" name="Person" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:Phase" xmi:id="PhaseA" name="PhaseA" visibility="public" isAbstract="false">
    <generalization xmi:id="PhaseAToPerson" general="Person" generalizationSet="Partition" />
  </packagedElement>
  <packagedElement xsi:type="RefOntoUML:Phase" xmi:id="PhaseB" name="PhaseB" visibility="public" isAbstract="false">
    <generalization xmi:id="PhaseBToPerson" general="Person" generalizationSet="Partition" />
  </packagedElement>
  <packagedElement xsi:type="RefOntoUML:DataType" xmi:id="Value" name="Value" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:GeneralizationSet" xmi:id="Partition" name="Partition" generalization="PhaseAToPerson PhaseBToPerson" isDisjoint="true" isCovering="true" />
</RefOntoUML:Package>