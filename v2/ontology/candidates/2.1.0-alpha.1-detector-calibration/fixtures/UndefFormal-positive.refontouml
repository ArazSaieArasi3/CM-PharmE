<?xml version='1.0' encoding='utf-8'?>
<RefOntoUML:Package xmlns:RefOntoUML="http://nemo.inf.ufes.br/ontouml/refontouml" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" xmi:id="pkg" name="UndefFormal-positive" visibility="public">
  <packagedElement xsi:type="RefOntoUML:Kind" xmi:id="PersonA" name="PersonA" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:Kind" xmi:id="PersonB" name="PersonB" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:DataType" xmi:id="Value" name="Value" visibility="public" isAbstract="false" />
  <packagedElement xsi:type="RefOntoUML:FormalAssociation" xmi:id="comparison" name="comparison" visibility="public" memberEnd="comparisonA comparisonB">
    <ownedEnd xmi:id="comparisonA" name="comparisonA" type="PersonA" association="comparison" aggregation="none" visibility="public">
      <lowerValue xsi:type="RefOntoUML:LiteralInteger" xmi:id="comparisonAlower" value="0" />
      <upperValue xsi:type="RefOntoUML:LiteralUnlimitedNatural" xmi:id="comparisonAupper" value="1" />
    </ownedEnd>
    <ownedEnd xmi:id="comparisonB" name="comparisonB" type="PersonB" association="comparison" aggregation="none" visibility="public">
      <lowerValue xsi:type="RefOntoUML:LiteralInteger" xmi:id="comparisonBlower" value="0" />
      <upperValue xsi:type="RefOntoUML:LiteralUnlimitedNatural" xmi:id="comparisonBupper" value="-1" />
    </ownedEnd>
  </packagedElement>
</RefOntoUML:Package>