cmpe:AlternativeMedicineAssignment a owl:Class ;
    rdfs:label "Alternative Medicinal Product Assignment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:ReferenceProductRole ;
            owl:onProperty cmpe:alternativeForProduct ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:AlternativeMedicinalProductRole ;
            owl:onProperty cmpe:alternativeProduct ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:ReferenceProductRole ;
            owl:onProperty cmpe:alternativeForProduct ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:AlternativeMedicinalProductRole ;
            owl:onProperty cmpe:alternativeProduct ] ;
    skos:altLabel "Alternative Medicine Assignment"@en ;
    cmmeta:conceptualModelVersion "2.1.0-alpha.1-g2-candidate" ;
    cmmeta:conceptualModule "extension" ;
    cmmeta:ontoumlStereotype "Relator" .

cmpe:AppliedClassificationEntryRole a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
