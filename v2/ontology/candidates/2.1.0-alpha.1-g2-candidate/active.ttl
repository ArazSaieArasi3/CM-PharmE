cmpe:assertionAboutProduct a owl:ObjectProperty ;
    rdfs:comment "Bounded product-target aboutness; the full polymorphic assertion target family remains for G3."@en ;
    rdfs:domain cmpe:Assertion ;
    rdfs:range cmpe:MedicinalProduct .

cmpe:authorizationJurisdiction a owl:ObjectProperty ;
    rdfs:domain cmpe:RegulatoryAuthorization ;
    rdfs:range cmpe:RegulatoryJurisdiction .

cmpe:baViewRepresents a owl:ObjectProperty ;
    rdfs:domain cmpe:BusinessArchitectureView .

cmpe:capacityBearer a owl:ObjectProperty ;
    rdfs:domain cmpe:SupplyCapacity .

cmpe:containsSourceRecord a owl:ObjectProperty ;
    rdfs:domain cmpe:DatasetRelease ;
    rdfs:range cmpe:SourceRecord .

cmpe:contextClassificationEntry a owl:ObjectProperty ;
    rdfs:domain cmpe:ContextualMedicineClassificationAssignment ;
    rdfs:range cmpe:AppliedClassificationEntryRole ;
    rdfs:subPropertyOf cmpe:classificationEntry .

cmpe:contextClassificationJurisdiction a owl:ObjectProperty ;
    rdfs:domain cmpe:ContextualMedicineClassificationAssignment ;
    rdfs:range cmpe:RegulatoryJurisdiction .

cmpe:contextClassificationProduct a owl:ObjectProperty ;
    rdfs:domain cmpe:ContextualMedicineClassificationAssignment ;
    rdfs:range cmpe:ClassifiedMedicinalProductRole ;
    rdfs:subPropertyOf cmpe:classificationEntity .

cmpe:disruptionAffectsDependency a owl:ObjectProperty ;
    rdfs:comment "Source-supported impact link only; does not entail causation of shortage."@en ;
    rdfs:domain cmpe:DisruptionEvent ;
    rdfs:range cmpe:SupplyDependency ;
    rdfs:subPropertyOf cmpe:disruptionAffects .

cmpe:entryInScheme a owl:ObjectProperty ;
    rdfs:domain cmpe:ClassificationEntry ;
    rdfs:range cmpe:ProductClassificationScheme .

cmpe:evidenceRecord a owl:ObjectProperty ;
    rdfs:domain cmpe:EvidenceSupport ;
    rdfs:range cmpe:EvidenceSourceRecordRole ;
    rdfs:subPropertyOf cmpe:evidenceItem .

cmpe:generatedAssertion a owl:ObjectProperty ;
    rdfs:domain cmpe:ProvenanceActivity ;
    rdfs:range cmpe:Assertion .

cmpe:hasActiveSubstance a owl:ObjectProperty ;
    rdfs:range cmpe:PharmaceuticalSubstance .

cmpe:hasDatasetRelease a owl:ObjectProperty ;
    rdfs:domain cmpe:Dataset ;
    rdfs:range cmpe:DatasetRelease .

cmpe:hasDosageForm a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicinalProductPresentation ;
    rdfs:range cmpe:DosageFormSpecification .

cmpe:hasMatchConfidence a owl:ObjectProperty ;
    rdfs:domain cmpe:EntityMatchAssertion ;
    rdfs:range cmpe:MatchConfidence .

cmpe:hasPackageConfiguration a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicinalProductPresentation ;
    rdfs:range cmpe:PackageConfiguration .

cmpe:hasStrength a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicinalProductPresentation ;
    rdfs:range cmpe:Strength .

cmpe:identifierLexicalValue a owl:DatatypeProperty ;
    rdfs:domain cmpe:IdentifierAssignment ;
    rdfs:range xsd:string .

cmpe:listingJurisdiction a owl:ObjectProperty ;
    rdfs:domain cmpe:MarketListing ;
    rdfs:range cmpe:RegulatoryJurisdiction .

cmpe:locatedIn a owl:ObjectProperty ;
    rdfs:range cmpe:GeographicFeature .

cmpe:maintainsDataset a owl:ObjectProperty ;
    rdfs:domain cmpe:DataSourceResource ;
    rdfs:range cmpe:Dataset .

cmpe:matchObject a owl:ObjectProperty ;
    rdfs:domain cmpe:EntityMatchAssertion .

cmpe:matchSubject a owl:ObjectProperty ;
    rdfs:domain cmpe:EntityMatchAssertion .

cmpe:measureNumericValue a owl:DatatypeProperty ;
    rdfs:domain cmpe:ObservationResult ;
    rdfs:range xsd:decimal .

cmpe:measureUnitLabel a owl:DatatypeProperty ;
    rdfs:domain cmpe:ObservationResult ;
    rdfs:range xsd:string .

cmmeta:conceptualModelVersion a owl:AnnotationProperty .

cmmeta:conceptualModule a owl:AnnotationProperty .

cmmeta:derivedFromRelator a owl:AnnotationProperty .

cmmeta:formalizationNote a owl:AnnotationProperty .

cmmeta:formalizationStatus a owl:AnnotationProperty .

cmmeta:gateDIdentifier a owl:AnnotationProperty .

cmmeta:materialRelation a owl:AnnotationProperty .

cmmeta:ontoumlStereotype a owl:AnnotationProperty .

cmmeta:persistentNamespaceStatus a owl:AnnotationProperty .

cmmeta:sourceStatus a owl:AnnotationProperty .

cmpe:observationAboutPresentation a owl:ObjectProperty ;
    rdfs:comment "Information about an identified presentation; no substitution for Product."@en ;
    rdfs:domain cmpe:ObservationResult ;
    rdfs:range cmpe:MedicinalProductPresentation ;
    rdfs:subPropertyOf cmpe:observationResultAbout .

cmpe:observationAboutProduct a owl:ObjectProperty ;
    rdfs:comment "Information about a product; not an observation event or a product identity assertion."@en ;
    rdfs:domain cmpe:ObservationResult ;
    rdfs:range cmpe:MedicinalProduct ;
    rdfs:subPropertyOf cmpe:observationResultAbout .

cmpe:ontology a owl:Ontology ;
    dcterms:creator "Araz Saie Arasi" ;
    dcterms:description "Non-release review snapshot derived from the frozen CM-PharmE 2.0 baseline; semantics remain provisional."@en ;
    dcterms:issued "2026-10-04"^^xsd:date ;
    dcterms:title "CM-PharmE 2.1 Design Candidate"@en ;
    owl:versionIRI cmpe:2.1.0-alpha.1-g2-candidate ;
    owl:versionInfo "2.1.0-alpha.1-g2-candidate" ;
    cmmeta:formalizationStatus "G2 source-bounded implementation candidate; author sign-off and full OntoUML semantics remain separate" ;
    cmmeta:persistentNamespaceStatus "w3id target namespace selected; redirect registration pending" .

cmpe:operates a owl:ObjectProperty ;
    rdfs:domain cmpe:Organization ;
    rdfs:range cmpe:Facility ;
    cmmeta:derivedFromRelator "FacilityOperation" ;
    cmmeta:materialRelation true .

cmpe:presentationOf a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicinalProductPresentation ;
    rdfs:range cmpe:MedicinalProduct .

cmpe:producesObservationResult a owl:ObjectProperty ;
    rdfs:domain cmpe:ObservationActivity ;
    rdfs:range cmpe:ObservationResult .

cmpe:registrationJurisdiction a owl:ObjectProperty ;
    rdfs:domain cmpe:EstablishmentRegistration ;
    rdfs:range cmpe:RegulatoryJurisdiction .

cmpe:reimbursementDiagnosisContext a owl:ObjectProperty ;
    rdfs:comment "Diagnosis classification context of an aggregate observation; never a patient diagnosis assertion."@en ;
    rdfs:domain cmpe:ReimbursementUtilisationObservationResult ;
    rdfs:range cmpe:DiagnosisClassificationReference .

cmpe:riskAssessmentConcernsDependency a owl:ObjectProperty ;
    rdfs:comment "Assessment topic only; no vulnerability or quantitative risk conclusion is entailed."@en ;
    rdfs:domain cmpe:RiskAssessmentActivity ;
    rdfs:range cmpe:SupplyDependency ;
    rdfs:subPropertyOf cmpe:riskAssessmentConcerns .

cmpe:riskTreatmentAddresses a owl:ObjectProperty ;
    rdfs:domain cmpe:RiskTreatmentActivity .

cmpe:shortageJurisdiction a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicineShortageSituation ;
    rdfs:range cmpe:RegulatoryJurisdiction .

cmpe:shortagePresentation a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicineShortageSituation ;
    rdfs:range cmpe:MedicinalProductPresentation .

cmpe:shortageProduct a owl:ObjectProperty ;
    rdfs:domain cmpe:MedicineShortageSituation ;
    rdfs:range cmpe:MedicinalProduct .

cmpe:usedSourceArtifact a owl:ObjectProperty ;
    rdfs:domain cmpe:ProvenanceActivity .

cmpe:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

cmpe:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

cmpe:withinCountry a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain cmpe:GeographicFeature ;
    rdfs:range cmpe:Country .

cmpe:withinRegion a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain cmpe:GeographicFeature ;
    rdfs:range cmpe:AdministrativeRegion .

cmpe:AdministrativeRegion a owl:Class ;
    rdfs:label "Administrative Region"@en ;
    rdfs:subClassOf cmpe:GeographicFeature ;
