cmpe:RegulatoryOversight a owl:Class ;
    rdfs:label "Regulatory Oversight"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:GovernedEntity ;
            owl:onProperty cmpe:oversightGovernedEntity ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:OversightAuthorityRole ;
            owl:onProperty cmpe:oversightAuthorityRole ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:OversightAuthorityRole ;
            owl:onProperty cmpe:oversightAuthorityRole ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:GovernedEntity ;
            owl:onProperty cmpe:oversightGovernedEntity ] ;
    cmmeta:conceptualModelVersion "2.1.0-alpha.1-g2-candidate" ;
    cmmeta:conceptualModule "extension" ;
    cmmeta:ontoumlStereotype "Relator" .

cmpe:alternativeProduct a owl:ObjectProperty ;
    rdfs:domain cmpe:AlternativeMedicineAssignment ;
    rdfs:range cmpe:AlternativeMedicinalProductRole .

cmpe:authorizationParty a owl:ObjectProperty ;
    rdfs:domain cmpe:RegulatoryAuthorization ;
    rdfs:range cmpe:AuthorizedParty .

cmpe:classificationEntity a owl:ObjectProperty ;
    rdfs:domain cmpe:ProductClassificationAssignment ;
    rdfs:range cmpe:ClassifiedEntity ;
    owl:propertyDisjointWith cmpe:classificationEntry .

cmpe:dependencyProvider a owl:ObjectProperty ;
    rdfs:domain cmpe:SupplyDependency ;
    rdfs:range cmpe:ProviderEntity .

cmpe:evidenceAssertion a owl:ObjectProperty ;
    rdfs:domain cmpe:EvidenceSupport ;
    rdfs:range cmpe:SupportedAssertionRole .

cmpe:evidenceItem a owl:ObjectProperty ;
    rdfs:domain cmpe:EvidenceSupport ;
    rdfs:range cmpe:EvidenceItem ;
    owl:propertyDisjointWith cmpe:evidenceAssertion .

cmpe:identifierScheme a owl:ObjectProperty ;
    rdfs:domain cmpe:IdentifierAssignment ;
    rdfs:range cmpe:UsedIdentifierSchemeRole .

cmpe:listingResponsibleOrganization a owl:ObjectProperty ;
    rdfs:domain cmpe:MarketListing ;
    rdfs:range cmpe:ListingResponsibleOrganizationRole .

cmpe:operationFacility a owl:ObjectProperty ;
    rdfs:domain cmpe:FacilityOperation ;
    rdfs:range cmpe:OperatedFacilityRole .

cmpe:oversightGovernedEntity a owl:ObjectProperty ;
    rdfs:domain cmpe:RegulatoryOversight ;
    rdfs:range cmpe:GovernedEntity .

cmpe:registrationEntity a owl:ObjectProperty ;
    rdfs:domain cmpe:EstablishmentRegistration ;
    rdfs:range cmpe:RegisteredParty .

cmpe:AuthorizedParty a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:RegulatoryAuthorization ;
            owl:onProperty [ owl:inverseOf cmpe:authorizationParty ] ] ;
    cmmeta:conceptualModelVersion "2.1.0-alpha.1-g2-candidate" ;
    cmmeta:ontoumlStereotype "RoleMixin" .

cmpe:ClassifiedEntity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cmpe:ProductClassificationAssignment ;
            owl:onProperty [ owl:inverseOf cmpe:classificationEntity ] ] ;
    cmmeta:conceptualModelVersion "2.1.0-alpha.1-g2-candidate" ;
    cmmeta:ontoumlStereotype "RoleMixin" .

cmpe:ContextualMedicineClassificationAssignment a owl:Class ;
