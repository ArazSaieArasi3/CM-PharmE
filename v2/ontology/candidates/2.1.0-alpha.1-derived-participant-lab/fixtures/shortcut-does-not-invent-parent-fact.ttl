@prefix ns1: <https://w3id.org/cm-pharme/2.1/> .

<urn:cmpe-participant-lab:support> a ns1:EvidenceSupport ;
    ns1:evidenceAssertion <urn:cmpe-participant-lab:claim> ;
    ns1:evidenceRecord <urn:cmpe-participant-lab:item> .

<urn:cmpe-participant-lab:claim> a ns1:Assertion,
        ns1:SupportedAssertionRole .

<urn:cmpe-participant-lab:item> a ns1:EvidenceItem,
        ns1:EvidenceSourceRecordRole,
        ns1:SourceRecord .
