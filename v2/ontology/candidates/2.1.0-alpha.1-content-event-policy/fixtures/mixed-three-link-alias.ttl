@prefix ns1: <https://w3id.org/cm-pharme/experimental/four-domain/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<urn:cmpe-policy:b> owl:sameAs <urn:cmpe-policy:a>,
        <urn:cmpe-policy:signal> .

<urn:cmpe-policy:result> owl:sameAs <urn:cmpe-policy:a> ;
    ns1:pvResultSignal <urn:cmpe-policy:signal> .

