@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix d: <https://w3id.org/cm-pharme/experimental/coherence/> .
@prefix l: <https://w3id.org/cm-pharme/experimental/four-domain/> .
@prefix ns1: <https://w3id.org/cm-pharme/2.1/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix r: <https://w3id.org/cm-pharme/experimental/refinement/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

prov:category a owl:AnnotationProperty ;
    rdfs:comment "Classify prov-o terms into three categories, including 'starting-point', 'qualifed', and 'extended'. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. "@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:component a owl:AnnotationProperty ;
    rdfs:comment "Classify prov-o terms into six components according to prov-dm, including 'agents-responsibility', 'alternate', 'annotations', 'collections', 'derivations', and 'entities-activities'. This classification is used so that readers of prov-o specification can find its correspondence with the prov-dm specification."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:constraints a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-CONSTRAINTS document that describes this concept."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:definition a owl:AnnotationProperty ;
    rdfs:comment "A definition quoted from PROV-DM or PROV-CONSTRAINTS that describes the concept expressed with this OWL term."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> .

prov:dm a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

prov:n a owl:AnnotationProperty ;
    rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    rdfs:subPropertyOf rdfs:seeAlso .

c:evidenceRecord a owl:ObjectProperty ;
    rdfs:domain c:EvidenceSupport ;
    rdfs:range c:EvidenceSourceRecordRole ;
    rdfs:subPropertyOf c:evidenceItem .

ns1:conceptualModelVersion a owl:AnnotationProperty .

ns1:conceptualModule a owl:AnnotationProperty .

ns1:ontoumlStereotype a owl:AnnotationProperty .

d:capabilityRealizedInLogistics a owl:ObjectProperty ;
    rdfs:domain c:EnterpriseCapability ;
    rdfs:range c:DistributionLogisticsActivity .

d:logisticsFacility a owl:ObjectProperty ;
    rdfs:domain c:DistributionLogisticsActivity ;
    rdfs:range c:Facility .

d:logisticsProduct a owl:ObjectProperty ;
    rdfs:domain c:DistributionLogisticsActivity ;
    rdfs:range c:MedicinalProduct .

l:profile a owl:DatatypeProperty ;
    rdfs:range xsd:string .

l:serviceCapability a owl:ObjectProperty ;
    rdfs:domain c:ServiceOfferingSpecification ;
    rdfs:range c:EnterpriseCapability .

l:viewOrganization a owl:ObjectProperty ;
    rdfs:domain c:BusinessArchitectureView ;
    rdfs:range c:Organization ;
    rdfs:subPropertyOf c:baViewRepresents .

l:viewService a owl:ObjectProperty ;
    rdfs:domain c:BusinessArchitectureView ;
    rdfs:range c:ServiceOfferingSpecification .

<https://w3id.org/cm-pharme/experimental/modules/BA/2026-10-09> a owl:Ontology ;
    rdfs:comment "Bounded selected-signature interface projection. Not an approved replacement or a locality module. Dependencies flattened; no remote imports." .

r:agreementCommitment a owl:ObjectProperty ;
    rdfs:domain c:StrategicPartnershipAgreement ;
    rdfs:range c:Assertion .

r:carrierClaim a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain c:SourceRecord ;
    rdfs:range c:Assertion .

r:claimText a owl:DatatypeProperty ;
    rdfs:range xsd:string .

r:commitmentActor a owl:ObjectProperty ;
    rdfs:domain c:Assertion ;
    rdfs:range c:Organization .

r:commitmentText a owl:DatatypeProperty ;
    rdfs:range xsd:string .

r:serviceFacility a owl:ObjectProperty ;
    rdfs:domain c:ServiceOfferingSpecification ;
    rdfs:range c:Facility .

r:serviceProduct a owl:ObjectProperty ;
    rdfs:domain c:ServiceOfferingSpecification ;
    rdfs:range c:MedicinalProduct .

c:EvidenceSourceRecordRole a owl:Class ;
    rdfs:subClassOf c:EvidenceItem,
        c:SourceRecord ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:ontoumlStereotype "Role" .

c:baViewRepresents a owl:ObjectProperty ;
    rdfs:domain c:BusinessArchitectureView .

c:capabilityBearer a owl:ObjectProperty ;
    rdfs:domain c:EnterpriseCapability ;
    rdfs:range c:Organization .

prov:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    prov:category "starting-point" ;
    prov:component "entities-activities" ;
    prov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI ;
    prov:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en ;
    prov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI ;
    prov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI .

c:Facility a owl:Class ;
    rdfs:label "Facility"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:MedicinalProduct a owl:Class ;
    rdfs:label "Medicinal Product"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:PartnerOrganizationRole a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:StrategicPartnershipAgreement ;
            owl:onProperty [ owl:inverseOf c:partnershipParticipant ] ],
        c:Organization ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:ontoumlStereotype "Role" .

c:SourceRecord a owl:Class ;
    rdfs:label "Source Record"@en ;
    rdfs:subClassOf prov:Entity ;
    skos:closeMatch prov:Entity ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Kind" .

c:BusinessArchitectureView a owl:Class ;
    rdfs:label "Business Architecture View"@en ;
    owl:disjointWith c:Organization ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "extension" ;
    ns1:ontoumlStereotype "Kind" .

c:DistributionLogisticsActivity a owl:Class ;
    rdfs:label "Pharmaceutical Logistics Activity"@en ;
    skos:altLabel "Distribution / Logistics Activity"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Event" .

c:EnterpriseCapability a owl:Class ;
    rdfs:label "Enterprise Capability"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass c:Organization ;
            owl:onProperty c:capabilityBearer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "extension" ;
    ns1:ontoumlStereotype "Mode" .

c:StrategicPartnershipAgreement a owl:Class ;
    rdfs:label "Strategic Partnership Agreement"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass c:PartnerOrganizationRole ;
            owl:onProperty c:partnershipParticipant ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass c:Organization ;
            owl:onProperty c:partnershipParticipant ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "extension" ;
    ns1:ontoumlStereotype "Relator" .

c:SupportedAssertionRole a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:EvidenceSupport ;
            owl:onProperty [ owl:inverseOf c:evidenceAssertion ] ],
        c:Assertion ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:ontoumlStereotype "Role" .

c:partnershipParticipant a owl:ObjectProperty ;
    rdfs:domain c:StrategicPartnershipAgreement ;
    rdfs:range c:PartnerOrganizationRole .

c:Assertion a owl:Class ;
    rdfs:label "Assertion"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Kind" .

c:EvidenceItem a owl:Class ;
    rdfs:label "Evidence Item"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:EvidenceSupport ;
            owl:onProperty [ owl:inverseOf c:evidenceItem ] ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "RoleMixin" .

c:ServiceOfferingSpecification a owl:Class ;
    rdfs:label "Service Offering Specification"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "extension" ;
    ns1:ontoumlStereotype "Kind" .

c:evidenceAssertion a owl:ObjectProperty ;
    rdfs:domain c:EvidenceSupport ;
    rdfs:range c:SupportedAssertionRole .

c:evidenceItem a owl:ObjectProperty ;
    rdfs:domain c:EvidenceSupport ;
    rdfs:range c:EvidenceItem ;
    owl:propertyDisjointWith c:evidenceAssertion .

c:EvidenceSupport a owl:Class ;
    rdfs:label "Evidence Support"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:EvidenceItem ;
            owl:onProperty c:evidenceItem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:SupportedAssertionRole ;
            owl:onProperty c:evidenceAssertion ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:SupportedAssertionRole ;
            owl:onProperty c:evidenceAssertion ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:EvidenceItem ;
            owl:onProperty c:evidenceItem ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Relator" .

c:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .
