@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix l: <https://w3id.org/cm-pharme/experimental/four-domain/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix t: <urn:cmpe-lab:> .

t:agreement a c:StrategicPartnershipAgreement ;
    c:partnershipParticipant t:org ;
    l:profile "ba-partnership" .

t:view a c:BusinessArchitectureView ;
    l:profile "ba-view" ;
    l:viewOrganization t:org ;
    l:viewService t:service .

t:cap a c:EnterpriseCapability ;
    c:capabilityBearer t:org .

t:org2 a c:Organization,
        c:PartnerOrganizationRole .

t:service a c:ServiceOfferingSpecification ;
    l:profile "ba-service" ;
    l:serviceCapability t:cap .

t:org a c:Organization,
        c:PartnerOrganizationRole ;
    owl:differentFrom t:org2 .
