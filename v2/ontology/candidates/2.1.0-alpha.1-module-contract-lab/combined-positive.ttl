<urn:cmpe-lab:substance> a ns4:PharmaceuticalSubstance .

<urn:cmpe-lab:transform2> a ns4:ProvenanceActivity ;
    ns2:atTime "2026-10-04T10:00:00+00:00"^^xsd:dateTime ;
    ns2:digitalActivityDeployment <urn:cmpe-lab:deployment2> ;
    ns2:profile "digital-activity",
        "manufacturing-data-activity" ;
    ns3:activityResponsibleOrganization <urn:cmpe-lab:processor> ;
    ns3:supportsManufacturing <urn:cmpe-lab:manufacturing> .

<urn:cmpe-lab:commitment> a ns4:Assertion,
        ns4:SupportedAssertionRole ;
    ns2:profile "commitment-assertion" ;
    ns3:commitmentActor <urn:cmpe-lab:org>,
        <urn:cmpe-lab:org2> ;
    ns3:commitmentText "Synthetic organizations commit to the stated joint service." .

<urn:cmpe-lab:commitmentRecord> a ns4:EvidenceItem,
        ns4:EvidenceSourceRecordRole,
        ns4:SourceRecord .

<urn:cmpe-lab:manufacturing> a ns4:ManufacturingActivity ;
    ns2:profile "manufacturing-context" ;
    ns3:manufacturingFacility <urn:cmpe-lab:manufacturingSite> ;
    ns3:manufacturingProduct <urn:cmpe-lab:manufacturedProduct> .

<urn:cmpe-lab:operator> a ns4:Organization .

<urn:cmpe-lab:processor> a ns4:Organization ;
    owl:differentFrom <urn:cmpe-lab:operator> .

<urn:cmpe-lab:reportCopy> a ns4:SourceRecord ;
    ns2:profile "report-carrier" ;
    ns3:carrierClaim <urn:cmpe-lab:reportedClaim>,
        <urn:cmpe-lab:updatedClaim> ;
    ns3:caseIdentifier "SYNTHETIC-CASE-1" ;
    ns3:caseIdentifierScheme "synthetic-local-case-id-not-E2B-conformance" .

<urn:cmpe-lab:reportedClaim> a ns4:Assertion ;
    owl:differentFrom <urn:cmpe-lab:updatedClaim> ;
    ns2:profile "report-claim" ;
    ns3:claimText "A source reports a suspected event; causation is unestablished." .

<urn:cmpe-lab:riskResult> a ns4:Assertion ;
    ns2:atTime "2026-10-01T10:00:00+00:00"^^xsd:dateTime ;
    ns2:citesSourceRecord <urn:cmpe-lab:source> ;
    ns2:conclusion "review supply continuity" ;
    ns2:profile "risk-result" ;
    ns2:resultAssessment <urn:cmpe-lab:assessment> .

<urn:cmpe-lab:scenario> a ns4:Assertion ;
    ns2:profile "risk-scenario" ;
    ns2:scenarioProduct <urn:cmpe-lab:product> ;
    ns3:scenarioDependency <urn:cmpe-lab:dependency> ;
    ns3:scenarioFacility <urn:cmpe-lab:riskFacility> .

<urn:cmpe-lab:source> a ns4:SourceRecord .

<urn:cmpe-lab:transform> a ns4:ProvenanceActivity ;
    ns2:atTime "2026-10-02T10:00:00+00:00"^^xsd:dateTime ;
    ns2:digitalActivityDeployment <urn:cmpe-lab:deployment> ;
    ns2:profile "digital-activity",
        "manufacturing-data-activity" ;
    ns3:activityResponsibleOrganization <urn:cmpe-lab:processor> ;
    ns3:supportsManufacturing <urn:cmpe-lab:manufacturing> .

<urn:cmpe-lab:updatedClaim> a ns4:Assertion ;
    ns2:profile "report-claim" ;
    ns3:claimText "Follow-up changes the reported clinical claim." .

<urn:cmpe-lab:component> a ns4:DigitalInformationSystemComponent .

<urn:cmpe-lab:org2> a ns4:Organization,
        ns4:PartnerOrganizationRole .

<urn:cmpe-lab:org> a ns4:Organization,
        ns4:PartnerOrganizationRole ;
