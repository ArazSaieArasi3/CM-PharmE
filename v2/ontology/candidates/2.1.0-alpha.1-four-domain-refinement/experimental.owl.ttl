    rdfs:range c:RiskTreatmentPlan .

l:ontology a owl:Ontology ;
    rdfs:comment "Review experiment only. No release or full OntoUML conformance claim." .

l:planRiskResult a owl:ObjectProperty ;
    rdfs:domain c:RiskTreatmentPlan ;
    rdfs:range c:Assertion .

l:profile a owl:DatatypeProperty ;
    rdfs:range xsd:string .

l:pvRequirementJurisdiction a owl:ObjectProperty ;
    rdfs:domain c:PharmacovigilanceRequirement ;
    rdfs:range c:RegulatoryJurisdiction .

l:pvResultAssessment a owl:ObjectProperty ;
    rdfs:domain c:Assertion ;
    rdfs:range c:SignalAssessmentActivity .

l:pvResultSignal a owl:ObjectProperty ;
    rdfs:domain c:Assertion ;
    rdfs:range c:Assertion .

l:recordDigitalActivity a owl:ObjectProperty ;
    rdfs:domain c:SourceRecord ;
    rdfs:range c:ProvenanceActivity .

l:reportsRecord a owl:ObjectProperty ;
    rdfs:domain c:AdverseEventReportingActivity ;
    rdfs:range c:SourceRecord .

l:resultAssessment a owl:ObjectProperty ;
    rdfs:domain c:Assertion ;
    rdfs:range c:RiskAssessmentActivity .

l:reviewNewResult a owl:ObjectProperty ;
    rdfs:domain c:RiskReviewActivity ;
    rdfs:range c:Assertion .

l:reviewPriorResult a owl:ObjectProperty ;
    rdfs:domain c:RiskReviewActivity ;
    rdfs:range c:Assertion .

l:scenarioProduct a owl:ObjectProperty ;
    rdfs:domain c:Assertion ;
    rdfs:range c:MedicinalProduct ;
