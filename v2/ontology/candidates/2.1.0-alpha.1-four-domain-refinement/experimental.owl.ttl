            owl:onProperty [ owl:inverseOf c:regulatoryMandateHolder ] ],
        c:EcosystemParticipant,
        c:Organization ;
    skos:altLabel "Regulatory Authority Role"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Role" .

c:RegulatoryAuthorization a owl:Class ;
    rdfs:label "Regulatory Authorization"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:AuthorizingAuthorityRole ;
            owl:onProperty c:authorizationAuthority ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:AuthorizedParty ;
            owl:onProperty c:authorizationParty ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:AuthorizingAuthorityRole ;
            owl:onProperty c:authorizationAuthority ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:AuthorizedParty ;
            owl:onProperty c:authorizationParty ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Relator" .

c:SupplyCapacity a owl:Class ;
    rdfs:label "Supply Capacity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty c:capacityBearer ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty c:capacityOrganizationBearer ;
                        owl:someValuesFrom c:Organization ] [ a owl:Restriction ;
                        owl:onProperty c:capacityFacilityBearer ;
                        owl:someValuesFrom c:Facility ] ) ] ;
    owl:disjointWith c:SupplyCapacityObservationResult ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Mode" .

c:classificationEntry a owl:ObjectProperty ;
    rdfs:domain c:ProductClassificationAssignment ;
    rdfs:range c:AppliedClassificationEntryRole .

c:DependentEntity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:SupplyDependency ;
            owl:onProperty [ owl:inverseOf c:dependencyDependent ] ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:ontoumlStereotype "RoleMixin" .

c:PharmaceuticalSubstance a owl:Class ;
    rdfs:label "Pharmaceutical Substance"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:ProviderEntity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:SupplyDependency ;
            owl:onProperty [ owl:inverseOf c:dependencyProvider ] ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:ontoumlStereotype "RoleMixin" .

c:ServiceOfferingSpecification a owl:Class ;
    rdfs:label "Service Offering Specification"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "extension" ;
    ns1:ontoumlStereotype "Kind" .

c:GeographicFeature a owl:Class ;
    rdfs:label "Geographic Feature"@en ;
    rdfs:seeAlso <https://www.geonames.org/ontology#Feature> ;
    owl:disjointWith c:RegulatoryJurisdiction ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Kind" .

c:ProvenanceActivity a owl:Class ;
    rdfs:label "Provenance Activity"@en ;
    skos:closeMatch prov:Activity ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Event" .

c:SupplyDependency a owl:Class ;
    rdfs:label "Supply Dependency"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:ProviderEntity ;
            owl:onProperty c:dependencyProvider ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:DependentEntity ;
            owl:onProperty c:dependencyDependent ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:ProviderEntity ;
            owl:onProperty c:dependencyProvider ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:DependentEntity ;
            owl:onProperty c:dependencyDependent ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "extension" ;
    ns1:ontoumlStereotype "Relator" .

c:RegulatoryJurisdiction a owl:Class ;
    rdfs:label "Regulatory Jurisdiction"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:EcosystemParticipant a owl:Class ;
    rdfs:label "Ecosystem Participant"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "RoleMixin" .

c:IdentifiedEntity a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass c:IdentifierAssignment ;
            owl:onProperty [ owl:inverseOf c:identifierEntity ] ] ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:ontoumlStereotype "RoleMixin" .

c:MedicinalProductPresentation a owl:Class ;
    rdfs:label "Medicinal Product Presentation"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:SourceRecord a owl:Class ;
    rdfs:label "Source Record"@en ;
    skos:closeMatch prov:Entity ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Kind" .

c:ObservationResult a owl:Class ;
    rdfs:label "Observation Result"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Kind" .

c:Facility a owl:Class ;
    rdfs:label "Facility"@en ;
    owl:disjointWith c:GeographicFeature ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:MedicinalProduct a owl:Class ;
    rdfs:label "Medicinal Product"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

c:Assertion a owl:Class ;
    rdfs:label "Assertion"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "x-infra" ;
    ns1:ontoumlStereotype "Kind" .

c:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    ns1:conceptualModelVersion "2.1.0-alpha.1-g3d-candidate" ;
    ns1:conceptualModule "core" ;
    ns1:ontoumlStereotype "Kind" .

[] a owl:AllDisjointClasses ;
    owl:members ( c:Organization c:Facility c:RegulatoryJurisdiction c:MedicinalProduct c:PharmaceuticalSubstance c:MedicinalProductPresentation ) .
