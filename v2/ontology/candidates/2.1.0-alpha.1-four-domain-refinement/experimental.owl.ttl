c:authorizationJurisdiction a owl:ObjectProperty ;
    rdfs:domain c:RegulatoryAuthorization ;
    rdfs:range c:RegulatoryJurisdiction .

c:containsSourceRecord a owl:ObjectProperty ;
    rdfs:domain c:DatasetRelease ;
    rdfs:range c:SourceRecord .

c:contextClassificationEntry a owl:ObjectProperty ;
    rdfs:domain c:ContextualMedicineClassificationAssignment ;
    rdfs:range c:AppliedClassificationEntryRole ;
    rdfs:subPropertyOf c:classificationEntry .

c:contextClassificationJurisdiction a owl:ObjectProperty ;
    rdfs:domain c:ContextualMedicineClassificationAssignment ;
    rdfs:range c:RegulatoryJurisdiction .

c:contextClassificationProduct a owl:ObjectProperty ;
    rdfs:domain c:ContextualMedicineClassificationAssignment ;
    rdfs:range c:ClassifiedMedicinalProductRole ;
    rdfs:subPropertyOf c:classificationEntity .

c:disruptionAffectsDependency a owl:ObjectProperty ;
    rdfs:comment "Source-supported impact link only; does not entail causation of shortage."@en ;
    rdfs:domain c:DisruptionEvent ;
    rdfs:range c:SupplyDependency ;
    rdfs:subPropertyOf c:disruptionAffects .

c:entryInScheme a owl:ObjectProperty ;
    rdfs:domain c:ClassificationEntry ;
    rdfs:range c:ProductClassificationScheme .

c:evidenceRecord a owl:ObjectProperty ;
    rdfs:domain c:EvidenceSupport ;
    rdfs:range c:EvidenceSourceRecordRole ;
    rdfs:subPropertyOf c:evidenceItem .

c:facilityHasSupplyCapacity a owl:ObjectProperty ;
    rdfs:domain c:Facility ;
    rdfs:range c:SupplyCapacity ;
    owl:inverseOf c:capacityFacilityBearer .

c:generatedAssertion a owl:ObjectProperty ;
    rdfs:domain c:ProvenanceActivity ;
    rdfs:range c:Assertion .

c:hasDatasetRelease a owl:ObjectProperty ;
    rdfs:domain c:Dataset ;
    rdfs:range c:DatasetRelease .

c:hasDosageForm a owl:ObjectProperty ;
    rdfs:domain c:MedicinalProductPresentation ;
    rdfs:range c:DosageFormSpecification .

c:hasPackageConfiguration a owl:ObjectProperty ;
    rdfs:domain c:MedicinalProductPresentation ;
    rdfs:range c:PackageConfiguration .

c:hasStrength a owl:ObjectProperty ;
    rdfs:domain c:MedicinalProductPresentation ;
    rdfs:range c:Strength .

c:identifierLexicalValue a owl:DatatypeProperty ;
    rdfs:domain c:IdentifierAssignment ;
    rdfs:range xsd:string .

c:listingJurisdiction a owl:ObjectProperty ;
    rdfs:domain c:MarketListing ;
    rdfs:range c:RegulatoryJurisdiction .

c:locatedIn a owl:ObjectProperty ;
    rdfs:range c:GeographicFeature .

c:maintainsDataset a owl:ObjectProperty ;
    rdfs:domain c:DataSourceResource ;
    rdfs:range c:Dataset .

c:matchObject a owl:ObjectProperty ;
    rdfs:domain c:EntityMatchAssertion .

c:matchSubject a owl:ObjectProperty ;
    rdfs:domain c:EntityMatchAssertion .

c:measureNumericValue a owl:DatatypeProperty ;
    rdfs:domain c:ObservationResult ;
    rdfs:range xsd:decimal .

c:measureUnitLabel a owl:DatatypeProperty ;
    rdfs:domain c:ObservationResult ;
    rdfs:range xsd:string .

ns1:conceptualModelVersion a owl:AnnotationProperty .

ns1:conceptualModule a owl:AnnotationProperty .

ns1:derivedFromRelator a owl:AnnotationProperty .

ns1:formalizationNote a owl:AnnotationProperty .

ns1:formalizationStatus a owl:AnnotationProperty .

ns1:gateDIdentifier a owl:AnnotationProperty .

ns1:materialRelation a owl:AnnotationProperty .

ns1:ontoumlStereotype a owl:AnnotationProperty .

ns1:persistentNamespaceStatus a owl:AnnotationProperty .

ns1:sourceStatus a owl:AnnotationProperty .

c:observationAboutPresentation a owl:ObjectProperty ;
    rdfs:comment "Information about an identified presentation; no substitution for Product."@en ;
    rdfs:domain c:ObservationResult ;
    rdfs:range c:MedicinalProductPresentation ;
    rdfs:subPropertyOf c:observationResultAbout .

c:observationAboutProduct a owl:ObjectProperty ;
    rdfs:comment "Information about a product; not an observation event or a product identity assertion."@en ;
    rdfs:domain c:ObservationResult ;
    rdfs:range c:MedicinalProduct ;
    rdfs:subPropertyOf c:observationResultAbout .

c:ontology a owl:Ontology ;
    dcterms:creator "Araz Saie Arasi" ;
    dcterms:description "Non-release review snapshot derived from the frozen CM-PharmE 2.0 baseline; semantics remain provisional."@en ;
    dcterms:issued "2026-10-04"^^xsd:date ;
    dcterms:title "CM-PharmE 2.1 Design Candidate"@en ;
    owl:versionIRI c:2.1.0-alpha.1-g3-2e-f-candidate ;
    owl:versionInfo "2.1.0-alpha.1-g3-2e-f-candidate" ;
    ns1:formalizationStatus "G3-2e-F supported OWL subset aligned to native G3-2e-E; official conformance and scientific release acceptance pending" ;
    ns1:persistentNamespaceStatus "w3id target namespace selected; redirect registration pending" .

c:operates a owl:ObjectProperty ;
    rdfs:domain c:Organization ;
    rdfs:range c:Facility ;
    ns1:derivedFromRelator "FacilityOperation" ;
    ns1:materialRelation true .

c:organizationHasSupplyCapacity a owl:ObjectProperty ;
    rdfs:domain c:Organization ;
    rdfs:range c:SupplyCapacity ;
    owl:inverseOf c:capacityOrganizationBearer .

c:presentationOf a owl:ObjectProperty ;
    rdfs:domain c:MedicinalProductPresentation ;
    rdfs:range c:MedicinalProduct .

c:producesObservationResult a owl:ObjectProperty ;
    rdfs:domain c:ObservationActivity ;
    rdfs:range c:ObservationResult .

c:productHasActiveSubstance a owl:ObjectProperty ;
    rdfs:comment "Evidence-admitted Product-specific active substance link; no global existence, maximum one, presentation promotion or composition assertion."@en ;
    rdfs:domain c:MedicinalProduct ;
    rdfs:range c:PharmaceuticalSubstance ;
    rdfs:subPropertyOf c:hasActiveSubstance .

c:registrationJurisdiction a owl:ObjectProperty ;
    rdfs:domain c:EstablishmentRegistration ;
    rdfs:range c:RegulatoryJurisdiction .

c:reimbursementDiagnosisContext a owl:ObjectProperty ;
    rdfs:comment "Diagnosis classification context of an aggregate observation; never a patient diagnosis assertion."@en ;
    rdfs:domain c:ReimbursementUtilisationObservationResult ;
    rdfs:range c:DiagnosisClassificationReference .

c:riskAssessmentConcernsDependency a owl:ObjectProperty ;
    rdfs:comment "Assessment topic only; no vulnerability or quantitative risk conclusion is entailed."@en ;
    rdfs:domain c:RiskAssessmentActivity ;
    rdfs:range c:SupplyDependency ;
    rdfs:subPropertyOf c:riskAssessmentConcerns .

c:riskTreatmentAddresses a owl:ObjectProperty ;
    rdfs:domain c:RiskTreatmentActivity .

c:shortageJurisdiction a owl:ObjectProperty ;
    rdfs:domain c:MedicineShortageSituation ;
    rdfs:range c:RegulatoryJurisdiction .

c:shortagePresentation a owl:ObjectProperty ;
    rdfs:domain c:MedicineShortageSituation ;
    rdfs:range c:MedicinalProductPresentation .

c:shortageProduct a owl:ObjectProperty ;
    rdfs:domain c:MedicineShortageSituation ;
    rdfs:range c:MedicinalProduct .

c:usedSourceArtifact a owl:ObjectProperty ;
    rdfs:domain c:ProvenanceActivity .

c:validFrom a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

c:validTo a owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

c:withinCountry a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain c:GeographicFeature ;
    rdfs:range c:Country .

c:withinRegion a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain c:GeographicFeature ;
    rdfs:range c:AdministrativeRegion .

