@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix t1: <urn:cmpe-prov-target:> .

t1:q a prov:Revision ;
    prov:entity t1:y .

t1:x prov:qualifiedRevision t1:q .

[] a owl:NegativePropertyAssertion ;
    owl:assertionProperty prov:wasDerivedFrom ;
    owl:sourceIndividual t1:x ;
    owl:targetIndividual t1:y .
