@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix q: <https://w3id.org/cm-pharme/experimental/prov-target/> .
@prefix r: <https://w3id.org/cm-pharme/experimental/refinement/> .

q:R3 a q:TargetCase ;
    q:claim q:R3-claim ;
    q:evidenceKind "co-report-only" ;
    q:family "assessment" ;
    q:source q:R3-event ;
    q:sourceRecord q:R3-record ;
    q:target q:R3-target ;
    q:targetClass c:RiskTreatmentPlan .

q:R3-event a c:RiskAssessmentActivity ;
    q:assessmentOutput q:R3-claim .

q:R3-record a c:SourceRecord ;
    r:carrierClaim q:R3-claim .

q:R3-target a c:RiskTreatmentPlan .

q:R3-claim a c:Assertion .
