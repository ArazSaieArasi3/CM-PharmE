@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix q: <https://w3id.org/cm-pharme/experimental/prov-target/> .
@prefix r: <https://w3id.org/cm-pharme/experimental/refinement/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

q:D3 a q:TargetCase ;
    q:claim q:D3-claim ;
    q:effectObservedAt "2026-09-01T02:00:00+00:00"^^xsd:dateTime ;
    q:eventStart "2026-09-01T01:00:00+00:00"^^xsd:dateTime ;
    q:evidenceKind "explicit-effect-report" ;
    q:family "disruption" ;
    q:source q:D3-event ;
    q:sourceRecord q:D3-record ;
    q:target q:D3-target ;
    q:targetClass c:SupplyDependency .

q:D3-dependent a c:DependentOrganizationRole,
        c:Organization .

q:D3-provider a c:Organization,
        c:ProviderOrganizationRole .

q:D3-record a c:SourceRecord ;
    r:carrierClaim q:D3-claim .

q:D3-claim a c:Assertion .

q:D3-event a c:DisruptionEvent .

q:D3-target a c:SupplyDependency ;
    c:dependencyDependent q:D3-dependent ;
    c:dependencyProvider q:D3-provider .

[] a owl:NegativePropertyAssertion ;
    owl:assertionProperty c:disruptionAffects ;
    owl:sourceIndividual q:D3-event ;
    owl:targetIndividual q:D3-target .
