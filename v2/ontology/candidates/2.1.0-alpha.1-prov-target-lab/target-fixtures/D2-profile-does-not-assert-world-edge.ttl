@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix q: <https://w3id.org/cm-pharme/experimental/prov-target/> .
@prefix r: <https://w3id.org/cm-pharme/experimental/refinement/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

q:D2 a q:TargetCase ;
    q:claim q:D2-claim ;
    q:effectObservedAt "2026-09-01T02:00:00+00:00"^^xsd:dateTime ;
    q:eventStart "2026-09-01T01:00:00+00:00"^^xsd:dateTime ;
    q:evidenceKind "explicit-effect-report" ;
    q:family "disruption" ;
    q:source q:D2-event ;
    q:sourceRecord q:D2-record ;
    q:target q:D2-target ;
    q:targetClass c:ManufacturingActivity .

q:D2-record a c:SourceRecord ;
    r:carrierClaim q:D2-claim .

q:D2-claim a c:Assertion .

q:D2-event a c:DisruptionEvent .

q:D2-target a c:ManufacturingActivity .

[] a owl:NegativePropertyAssertion ;
    owl:assertionProperty c:disruptionAffects ;
    owl:sourceIndividual q:D2-event ;
    owl:targetIndividual q:D2-target .
