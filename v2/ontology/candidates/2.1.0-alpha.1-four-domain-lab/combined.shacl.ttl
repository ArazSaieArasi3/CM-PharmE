lab:deployment-before-use a sh:SPARQLConstraint ;
    sh:message "A deployment must not postdate its use." ;
    sh:select "SELECT $this WHERE { $this <https://w3id.org/cm-pharme/experimental/four-domain/digitalActivityDeployment> ?d ; <https://w3id.org/cm-pharme/experimental/four-domain/atTime> ?t . ?d <https://w3id.org/cm-pharme/experimental/four-domain/atTime> ?dt . FILTER(?dt > ?t) }" .

lab:distinct-AdverseEventReportingActivity-SourceRecord a sh:SPARQLConstraint ;
    sh:message "Content and real-world bearer/occurrence must not be the same node." ;
    sh:select "SELECT $this WHERE { $this a <https://w3id.org/cm-pharme/2.1/AdverseEventReportingActivity> , <https://w3id.org/cm-pharme/2.1/SourceRecord> . }" .

lab:distinct-BusinessArchitectureView-Organization a sh:SPARQLConstraint ;
    sh:message "Content and real-world bearer/occurrence must not be the same node." ;
    sh:select "SELECT $this WHERE { $this a <https://w3id.org/cm-pharme/2.1/BusinessArchitectureView> , <https://w3id.org/cm-pharme/2.1/Organization> . }" .

lab:distinct-RiskAssessmentActivity-Assertion a sh:SPARQLConstraint ;
    sh:message "Content and real-world bearer/occurrence must not be the same node." ;
    sh:select "SELECT $this WHERE { $this a <https://w3id.org/cm-pharme/2.1/RiskAssessmentActivity> , <https://w3id.org/cm-pharme/2.1/Assertion> . }" .

lab:distinct-SignalAssessmentActivity-Assertion a sh:SPARQLConstraint ;
    sh:message "Content and real-world bearer/occurrence must not be the same node." ;
    sh:select "SELECT $this WHERE { $this a <https://w3id.org/cm-pharme/2.1/SignalAssessmentActivity> , <https://w3id.org/cm-pharme/2.1/Assertion> . }" .

lab:distinct-SourceRecord-DigitalInformationSystemComponent a sh:SPARQLConstraint ;
    sh:message "Content and real-world bearer/occurrence must not be the same node." ;
    sh:select "SELECT $this WHERE { $this a <https://w3id.org/cm-pharme/2.1/SourceRecord> , <https://w3id.org/cm-pharme/2.1/DigitalInformationSystemComponent> . }" .

