lab:partners-not-known-aliases a sh:SPARQLConstraint ;
    sh:message "Two known aliases do not establish two distinct organizations." ;
    sh:select "SELECT DISTINCT $this WHERE { $this <https://w3id.org/cm-pharme/2.1/partnershipParticipant> ?a, ?b . ?a <http://www.w3.org/2002/07/owl#sameAs> ?b . FILTER(?a != ?b) }" .

lab:review-time-order a sh:SPARQLConstraint ;
    sh:message "New result must not predate the prior result." ;
    sh:select "SELECT $this WHERE { $this <https://w3id.org/cm-pharme/experimental/four-domain/reviewPriorResult> ?old ; <https://w3id.org/cm-pharme/experimental/four-domain/reviewNewResult> ?new . ?old <https://w3id.org/cm-pharme/experimental/four-domain/atTime> ?a . ?new <https://w3id.org/cm-pharme/experimental/four-domain/atTime> ?b . FILTER(?b <= ?a) }" .

lab:signal-result-agreement a sh:SPARQLConstraint ;
    sh:message "The recorded result and producing assessment must refer to the same signal." ;
    sh:select "SELECT $this WHERE { $this <https://w3id.org/cm-pharme/experimental/four-domain/pvResultSignal> ?s ; <https://w3id.org/cm-pharme/experimental/four-domain/pvResultAssessment> ?a . FILTER NOT EXISTS { ?a <https://w3id.org/cm-pharme/experimental/four-domain/signalAssessmentTarget> ?s } }" .

lab:signal-result-distinct a sh:SPARQLConstraint ;
    sh:message "An assessment result must not be its own assessed signal or a known alias of it." ;
    sh:select "SELECT $this WHERE { $this <https://w3id.org/cm-pharme/experimental/four-domain/pvResultSignal> ?s . FILTER($this = ?s || EXISTS { $this <http://www.w3.org/2002/07/owl#sameAs> ?s } || EXISTS { ?s <http://www.w3.org/2002/07/owl#sameAs> $this }) }" .

lab:signal-target-required a sh:SPARQLConstraint ;
    sh:message "A signal must name a product or substance." ;
    sh:select "SELECT $this WHERE { FILTER NOT EXISTS { $this <https://w3id.org/cm-pharme/experimental/four-domain/signalProduct> ?p } FILTER NOT EXISTS { $this <https://w3id.org/cm-pharme/experimental/four-domain/signalSubstance> ?s } }" .
