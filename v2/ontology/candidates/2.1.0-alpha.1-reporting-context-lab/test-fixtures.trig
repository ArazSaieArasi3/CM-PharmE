@prefix ns1: <https://w3id.org/cm-pharme/experimental/reporting-context/> .
@prefix ns2: <https://w3id.org/cm-pharme/experimental/refinement/> .
@prefix ns3: <https://w3id.org/cm-pharme/2.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:cmpe-context-case:resource-and-literal-object> {
    <urn:cmpe-context:record> a ns3:SourceRecord ;
        ns2:carrierClaim <urn:cmpe-context:claim> .

    <urn:cmpe-context:claim> a ns1:StructuredClaim ;
        ns1:claimOrigin "synthetic" ;
        ns1:claimSubject <urn:cmpe-context:listing> ;
        ns1:evidencePointer "synthetic:/claim" ;
        ns1:objectResource <urn:cmpe-context:presentation> ;
        ns1:objectValue "extra" ;
        ns1:polarity "positive" ;
        ns1:predicateIRI "https://w3id.org/cm-pharme/2.1/listingPresentation"^^xsd:anyURI .
}

<urn:cmpe-context-case:missing-portfolio> {
    <urn:cmpe-context:context> a ns1:ReportingContextDescription ;
        ns1:contextAction <urn:cmpe-context:action> ;
        ns1:contextActor <urn:cmpe-context:org> ;
        ns1:contextCountry "DE" ;
        ns1:contextJurisdiction <urn:cmpe-context:jurisdiction> ;
        ns1:contextPresentation <urn:cmpe-context:presentation> ;
        ns1:contextProduct <urn:cmpe-context:product> ;
        ns1:contextRole "MAH" ;
        ns1:contextRoute "CAP" ;
        ns1:contextVersion "synthetic-v1" ;
        ns1:evaluatedAt "2026-10-10T00:00:00+00:00"^^xsd:dateTime ;
        ns1:marketingCountry "DE" ;
        ns1:marketingStatus "marketed" ;
        ns1:scenario "preparedness" ;
        ns1:submissionKind "availability" .

    <urn:cmpe-context:spec> a ns1:ReportingScopeSpecification ;
        ns1:actionEvidence <urn:cmpe-context:notice> ;
        ns1:actionEvidenceKind "action-announcement" ;
        ns1:actionReference <urn:cmpe-context:action> ;
        ns1:actionState "announced" ;
        ns1:allowedRole "MAH" ;
        ns1:allowedRoute "CAP" ;
        ns1:effectiveFrom "2026-10-01T00:00:00+00:00"^^xsd:dateTime ;
        ns1:effectiveTo "2026-11-01T00:00:00+00:00"^^xsd:dateTime ;
        ns1:marketingPolicy "require-marketed-status" ;
        ns1:reportingFrequency "synthetic-weekly" ;
        ns1:scenario "preparedness" ;
        ns1:scopeComplete true ;
        ns1:scopeJurisdiction <urn:cmpe-context:jurisdiction> ;
        ns1:scopeMode "enumerated" ;
        ns1:scopedProduct <urn:cmpe-context:product> ;
        ns1:specificationSource <urn:cmpe-context:document> ;
        ns1:specificationVersion "synthetic-v1" ;
        ns1:submissionKind "availability" .

    <urn:cmpe-context:document> a ns3:SourceRecord .

    <urn:cmpe-context:notice> a ns3:SourceRecord .

    <urn:cmpe-context:org> a ns3:Organization .

    <urn:cmpe-context:jurisdiction> a ns3:RegulatoryJurisdiction .

    <urn:cmpe-context:presentation> a ns3:MedicinalProductPresentation ;
        ns3:presentationOf <urn:cmpe-context:product> .

    <urn:cmpe-context:product> a ns3:MedicinalProduct .
}

