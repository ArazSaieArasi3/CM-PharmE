@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p: <https://w3id.org/cm-pharme/experimental/registry-policy/> .
@prefix t: <urn:cmpe-registry-policy:> .

t:claim a [ owl:complementOf c:MedicineShortageSituation ],
        c:Assertion ;
    c:assertionAboutProduct t:product ;
    p:profile "shortage-claim" ;
    p:shortageStatus "potential" .

t:product a c:MedicinalProduct .
