@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix p: <https://w3id.org/cm-pharme/experimental/registry-policy/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix t: <urn:cmpe-registry-policy:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

t:fact a c:MarketListing ;
    c:listingJurisdiction t:jurisdiction ;
    c:listingPresentation t:presentation ;
    c:listingResponsibleOrganization t:reporter .

t:jurisdiction a c:RegulatoryJurisdiction .

t:product a c:MedicinalProduct .

t:record a c:SourceRecord ;
    prov:wasAttributedTo t:reporter ;
    p:approvalConclusion "unknown" ;
    p:externalKey "SYNTHETIC-001" ;
    p:marketingEnd "2026-08-01"^^xsd:date ;
    p:marketingStart "2026-09-01"^^xsd:date ;
    p:profile "registry-record" ;
    p:recordKind "listing" ;
    p:recordSubject t:presentation ;
    p:release t:release ;
    p:representsFact t:fact ;
    p:retrievedAt "2026-10-01T10:00:00+00:00"^^xsd:dateTime .

t:release a c:DatasetRelease ;
    c:containsSourceRecord t:record .

t:presentation a c:ListedPresentationRole,
        c:MedicinalProductPresentation ;
    c:presentationOf t:product .

t:reporter a c:ListingResponsibleOrganizationRole,
        c:Organization .
