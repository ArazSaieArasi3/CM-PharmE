        ns4:PartnerOrganizationRole .

<urn:cmpe-lab:org> a ns4:Organization,
        ns4:PartnerOrganizationRole ;
    owl:differentFrom <urn:cmpe-lab:org2> .

<urn:cmpe-lab:report> a ns4:SourceRecord ;
    owl:differentFrom <urn:cmpe-lab:reportCopy> ;
    l:profile "report-carrier" ;
    ns3:carrierClaim <urn:cmpe-lab:reportedClaim> ;
    ns3:caseIdentifier "SYNTHETIC-CASE-1" ;
    ns3:caseIdentifierScheme "synthetic-local-case-id-not-E2B-conformance" .

<urn:cmpe-lab:signal> a ns4:Assertion ;
    l:citesSourceRecord <urn:cmpe-lab:report>,
        <urn:cmpe-lab:study> ;
    l:profile "safety-signal" ;
    l:signalProduct <urn:cmpe-lab:medicine> ;
    l:signalSubstance <urn:cmpe-lab:substance> .

t:RM-EMA-2020 a ns4:SourceRecord ;
    e:sourceDate "2020-11-13" ;
    e:sourceDateKind "document-date" ;
    e:sourceID "RM-EMA-2020" ;
    ns3:carrierClaim t:map-0,
        t:map-1,
        t:map-2,
        t:map-3,
        t:rm-control-required,
        t:rm-excluded-1,
        t:rm-excluded-2,
        t:rm-excluded-3,
        t:rm-included-1,
        t:rm-included-2,
        t:rm-included-3,
        t:rm-included-4,
        t:rm-included-5,
        t:rm-new-scope,
        t:rm-prior-scope,
        t:rm-review,
        t:rm-testing-required ;
    ns5:sourceURL "https://www.ema.europa.eu/en/documents/referral/angiotensin-ii-receptor-antagonists-sartans-article-31-referral-nitrosamines-ema-aligns-recommendations-sartans-those-other-medicines_en.pdf"^^xsd:anyURI .

t:GLTA a ns4:StrategicPartnershipAgreement ;
    ns4:partnershipParticipant t:LonzaLtd,
        t:LonzaSales,
        t:ModernaTX ;
    l:profile "ba-partnership",
        "documented-partnership" ;
    ns3:agreementCommitment t:workOrderCommitment .

<urn:cmpe-group:document> a ns4:SourceRecord ;
    ns5:sourceSHA256 "f645702d0abbbae65654ba1fea63f450fbd2827a6657714b832e088d667c38d9" ;
    ns5:sourceURL "https://www.ema.europa.eu/en/documents/prac-recommendation/prac-recommendations-signals-adopted-31-august-3-september-2026-prac-meeting_en.pdf"^^xsd:anyURI .
