    <urn:cmpe-coherence:capability-logistics> a ns3:EnterpriseCapability ;
        ns3:capabilityBearer <urn:cmpe-coherence:bearer> ;
        ns1:capabilityRealizedInLogistics <urn:cmpe-coherence:DistributionLogisticsActivity> ;
