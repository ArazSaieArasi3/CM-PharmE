<urn:coherence-case:PV-original-positive-replay> {
    <urn:cmpe-lab:jB> a ns3:RegulatoryJurisdiction .

    <urn:cmpe-lab:reporting> a ns3:AdverseEventReportingActivity ;
        ns2:atTime "2026-10-01T10:00:00+00:00"^^xsd:dateTime ;
        ns2:profile "safety-reporting" ;
        ns2:reportsRecord <urn:cmpe-lab:report> .

    <urn:cmpe-lab:signalResult> a ns3:Assertion ;
        ns2:atTime "2026-10-02T10:00:00+00:00"^^xsd:dateTime ;
        ns2:profile "signal-result" ;
        ns2:pvResultAssessment <urn:cmpe-lab:signalAssessment> ;
        ns2:pvResultSignal <urn:cmpe-lab:signal> ;
        ns2:signalStatus "under-review" .

    <urn:cmpe-lab:surveillance> a ns3:PostMarketSurveillanceActivity ;
        ns2:profile "pv-surveillance" ;
        ns2:surveillanceRequirement <urn:cmpe-lab:pvRule> ;
        ns2:surveillanceSource <urn:cmpe-lab:report> .

    <urn:cmpe-lab:jA> a ns3:RegulatoryJurisdiction .

    <urn:cmpe-lab:medicine> a ns3:MedicinalProduct .

    <urn:cmpe-lab:pvRule> a ns3:PharmacovigilanceRequirement ;
        ns2:profile "pv-requirement" ;
        ns2:pvRequirementJurisdiction <urn:cmpe-lab:jA> .

    <urn:cmpe-lab:signalAssessment> a ns3:SignalAssessmentActivity ;
        ns2:profile "signal-assessment" ;
        ns2:signalAssessmentTarget <urn:cmpe-lab:signal> .

    <urn:cmpe-lab:signal> a ns3:Assertion ;
        ns2:citesSourceRecord <urn:cmpe-lab:report> ;
        ns2:profile "safety-signal" ;
        ns2:signalProduct <urn:cmpe-lab:medicine> .

    <urn:cmpe-lab:report> a ns3:SourceRecord .
}

