    <urn:cmpe-coherence:digital-logistics> a ns3:ProvenanceActivity ;
        ns1:profile "digital-logistics" ;
        ns1:supportsLogistics <urn:cmpe-coherence:DistributionLogisticsActivity> .
}

<urn:coherence-case:requirement-positive> {
    <urn:cmpe-coherence:requirement> a ns3:RegulatoryRequirement ;
        ns1:profile "requirement" ;
        ns1:requirementJurisdiction <urn:cmpe-coherence:RegulatoryJurisdiction> ;
        ns1:requirementSource <urn:cmpe-coherence:SourceRecord> .

    <urn:cmpe-coherence:RegulatoryJurisdiction> a ns3:RegulatoryJurisdiction .

    <urn:cmpe-coherence:SourceRecord> a ns3:SourceRecord .
}

<urn:coherence-case:logistics-missing-logisticsProduct> {
    <urn:cmpe-coherence:logistics> a ns3:DistributionLogisticsActivity ;
        ns1:logisticsFacility <urn:cmpe-coherence:Facility> ;
        ns1:profile "logistics" .

    <urn:cmpe-coherence:Facility> a ns3:Facility .

    <urn:cmpe-coherence:MedicinalProduct> a ns3:MedicinalProduct .
}

<urn:coherence-case:RM-original-positive-replay> {
    <urn:cmpe-lab:plan> a ns3:RiskTreatmentPlan ;
        ns2:planRiskResult <urn:cmpe-lab:riskResult> ;
        ns2:profile "risk-plan" .

    <urn:cmpe-lab:assessment> a ns3:RiskAssessmentActivity ;
        ns2:assessmentScenario <urn:cmpe-lab:scenario> ;
        ns2:profile "risk-assessment" .

    <urn:cmpe-lab:product> a ns3:MedicinalProduct .

    <urn:cmpe-lab:riskResult> a ns3:Assertion ;
        ns2:atTime "2026-10-01T10:00:00+00:00"^^xsd:dateTime ;
        ns2:citesSourceRecord <urn:cmpe-lab:source> ;
        ns2:conclusion "review supply continuity" ;
        ns2:profile "risk-result" ;
        ns2:resultAssessment <urn:cmpe-lab:assessment> .

    <urn:cmpe-lab:scenario> a ns3:Assertion ;
        ns2:profile "risk-scenario" ;
        ns2:scenarioProduct <urn:cmpe-lab:product> .

    <urn:cmpe-lab:source> a ns3:SourceRecord .
}

