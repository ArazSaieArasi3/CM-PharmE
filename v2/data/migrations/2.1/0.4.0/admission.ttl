@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix m3: <urn:cmpe:rdb-m3:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Local closed-world admission profile, not new universal ontology axioms.
m3:SourceQualifiedManufacturer a sh:NodeShape ;
    sh:targetClass c:ManufacturingResponsibility ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:class c:SourceRecord ; sh:nodeKind sh:IRI ],
                [ sh:path dct:relation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
                [ sh:path dct:type ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("documentary_attribution" "synthetic_fixture") ] ;
    sh:sparql [ sh:message "Evidence, assertion, source and manufacturer/product must align" ;
        sh:select """
          PREFIX c: <https://w3id.org/cm-pharme/2.1/>
          PREFIX prov: <http://www.w3.org/ns/prov#>
          PREFIX dct: <http://purl.org/dc/terms/>
          PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
          SELECT $this WHERE {
            $this prov:wasDerivedFrom ?source ; dct:relation ?evidence ;
                  c:manufacturingResponsibilityHolder ?org ;
                  c:manufacturingResponsibilityCounterpart ?product .
            FILTER NOT EXISTS {
              ?evidence prov:wasDerivedFrom ?source ; dct:relation ?assertion .
              ?assertion rdf:subject ?org ; rdf:object ?product ;
                         rdf:predicate <urn:cmpe:rdb-m3:documented_manufacturer> .
            }
          }
        """ ] .
