@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix m4: <urn:cmpe:rdb-m4:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Unknown capacity provenance is allowed. Asserted provenance must be complete.
m4:CapacityProvenanceAdmission a sh:NodeShape ;
  sh:targetClass c:SupplyCapacity ;
  sh:xone (
    [ sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 0 ],
                  [ sh:path dct:relation ; sh:maxCount 0 ] ]
    [ sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class c:SourceRecord ],
                  [ sh:path dct:relation ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ]
  ) ;
  sh:sparql [ sh:message "Asserted source/evidence must support the primary typed bearer route" ;
    sh:select """
      PREFIX c: <https://w3id.org/cm-pharme/2.1/>
      PREFIX prov: <http://www.w3.org/ns/prov#>
      PREFIX dct: <http://purl.org/dc/terms/>
      PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
      SELECT $this WHERE {
        $this prov:wasDerivedFrom ?source ; dct:relation ?evidence .
        ?bearer ?primary $this .
        FILTER (?primary IN (c:organizationHasSupplyCapacity, c:facilityHasSupplyCapacity))
        FILTER NOT EXISTS {
          ?evidence prov:wasDerivedFrom ?source ; dct:relation ?assertion .
          ?assertion rdf:subject ?bearer ; rdf:predicate ?primary ; rdf:object $this .
        }
      }
    """ ] .
