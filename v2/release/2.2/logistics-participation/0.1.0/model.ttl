@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix d: <https://w3id.org/cm-pharme/experimental/coherence/> .
@prefix p: <https://w3id.org/cm-pharme/experimental/logistics-site/0.1.0/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Bounded review vocabulary. No global existence, uniqueness or site-function
# disjointness assertion. Candidate statements require opted-in source claims.
c:DistributionLogisticsActivity a owl:Class .
c:Facility a owl:Class .
d:logisticsFacility a owl:ObjectProperty ;
  rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility .
p:logisticsOriginFacility a owl:ObjectProperty ;
  rdfs:subPropertyOf d:logisticsFacility ;
  rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility .
p:logisticsDestinationFacility a owl:ObjectProperty ;
  rdfs:subPropertyOf d:logisticsFacility ;
  rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility .
p:logisticsStorageFacility a owl:ObjectProperty ;
  rdfs:subPropertyOf d:logisticsFacility ;
  rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility .
