@prefix ns1: <https://w3id.org/cm-pharme/2.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:orsd-02:capZero> a [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://w3id.org/cm-pharme/experimental/coherence/capabilityRealizedInLogistics> ],
        ns1:EnterpriseCapability ;
    ns1:capabilityBearer <urn:orsd-02:org> .

<urn:orsd-02:org> a ns1:Organization .

