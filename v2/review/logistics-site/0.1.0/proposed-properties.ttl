@prefix c: <https://w3id.org/cm-pharme/2.1/> .
@prefix d: <https://w3id.org/cm-pharme/experimental/coherence/> .
@prefix p: <https://w3id.org/cm-pharme/experimental/logistics-site/0.1.0/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Decision-ready proposal only. No universal existence, uniqueness, inverse,
# disjoint-function or source-support-implies-truth axiom is asserted.
p:logisticsOriginFacility a owl:ObjectProperty ;
    rdfs:subPropertyOf d:logisticsFacility ;
    rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility ;
    rdfs:comment "Proposed physical origin participation explicitly identified for the particular logistics activity; not an organization or legal-site designation."@en .
p:logisticsDestinationFacility a owl:ObjectProperty ;
    rdfs:subPropertyOf d:logisticsFacility ;
    rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility ;
    rdfs:comment "Proposed physical receiving/destination participation explicitly identified for the particular activity; not inferred from a consignee headquarters address."@en .
p:logisticsStorageFacility a owl:ObjectProperty ;
    rdfs:subPropertyOf d:logisticsFacility ;
    rdfs:domain c:DistributionLogisticsActivity ; rdfs:range c:Facility ;
    rdfs:comment "Proposed physical storage participation explicitly identified for the particular activity; not automatically its origin or final destination."@en .
