    r:CMPE-R0033 ex:manufacturer ;
    r:CMPE-R0034 ex:riskManagement .
ex:supplyChainRelationship a c:CMPE-C0032 ; r:CMPE-R0024 ex:blockchainLedger ; r:CMPE-R0028 ex:manufacturer .
