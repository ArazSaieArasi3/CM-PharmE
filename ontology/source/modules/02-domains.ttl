@prefix d: <https://w3id.org/cm-pharme/domain/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix meta: <https://w3id.org/cm-pharme/meta/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

d:CMPE-D0001 a skos:Concept ; dcterms:identifier "CMPE-D0001" ; skos:definition "enterprise structure, organizational units, stakeholder roles, capabilities, resource allocation, and internal governance arrangements." ; skos:prefLabel "Organizational / Structural" ; meta:status "active" .
d:CMPE-D0002 a skos:Concept ; dcterms:identifier "CMPE-D0002" ; skos:definition "inter-organizational actors, relationships, partnership arrangements, ecosystem governance, demand and supply signals, and service offerings." ; skos:prefLabel "Ecosystem / Collaborative" ; meta:status "active" .
d:CMPE-D0003 a skos:Concept ; dcterms:identifier "CMPE-D0003" ; skos:definition "pharmaceutical and clinical activities, pathways, reporting, surveillance, and operational participation." ; skos:prefLabel "Operational / Process" ; meta:status "active" .
d:CMPE-D0004 a skos:Concept ; dcterms:identifier "CMPE-D0004" ; skos:definition "regulatory authorities, oversight, policy, compliance, pharmacovigilance requirements, and risk-management constraints." ; skos:prefLabel "Governance / Regulatory" ; meta:status "active" .
d:CMPE-D0005 a skos:Concept ; dcterms:identifier "CMPE-D0005" ; skos:definition "digital platforms and information technologies that enable data exchange, clinical support, traceability, interoperability, and digitally mediated coordination." ; skos:prefLabel "Digital Transformation" ; meta:status "active" .
