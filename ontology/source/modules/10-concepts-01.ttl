c:CMPE-C0004 a owl:Class ; dcterms:identifier "CMPE-C0004" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0024 ; owl:onProperty [ owl:inverseOf r:CMPE-R0019 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A relator representing the regulatory relationship through which regulatory authority roles constrain or supervise governed pharmaceutical activities or entities." ; skos:prefLabel "Regulatory Oversight" ; meta:additionalDomain d:CMPE-D0002 ; meta:primaryDomain d:CMPE-D0004 ; meta:status "active" ; meta:stereotype meta:Relator .
c:CMPE-C0005 a owl:Class ; dcterms:identifier "CMPE-C0005" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0001 ; owl:onProperty r:CMPE-R0004 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "An intrinsic organizational capability of a pharmaceutical enterprise to perform or support a class of activities." ; skos:prefLabel "Enterprise Capability" ; meta:primaryDomain d:CMPE-D0001 ; meta:status "active" ; meta:stereotype meta:Mode .
c:CMPE-C0006 a owl:Class ; dcterms:identifier "CMPE-C0006" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0002 ; owl:onProperty r:CMPE-R0005 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A mode representing how organizational resources are intentionally distributed among units or strategic priorities." ; skos:prefLabel "Strategic Resource Allocation" ; meta:primaryDomain d:CMPE-D0001 ; meta:status "active" ; meta:stereotype meta:Mode .
c:CMPE-C0007 a owl:Class ; dcterms:identifier "CMPE-C0007" ; rdfs:subClassOf c:CMPE-C0003 ; skos:definition "An organizational stakeholder role borne by personnel engaged in clinical work." ; skos:prefLabel "Clinical Workforce" ; meta:additionalDomain d:CMPE-D0003 ; meta:primaryDomain d:CMPE-D0001 ; meta:status "active" ; meta:stereotype meta:Role .
c:CMPE-C0002 a owl:Class ; dcterms:identifier "CMPE-C0002" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0001 ; owl:onProperty r:CMPE-R0003 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "An organizational structural arrangement that partitions a pharmaceutical enterprise into units with differentiated responsibilities." ; skos:prefLabel "Organizational Unit Structure" ; meta:primaryDomain d:CMPE-D0001 ; meta:status "active" ; meta:stereotype meta:Kind .
c:CMPE-C0003 a owl:Class ; dcterms:identifier "CMPE-C0003" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0025 ; owl:onProperty r:CMPE-R0002 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass c:CMPE-C0015 ; owl:onProperty [ owl:inverseOf r:CMPE-R0012 ] ], [ a owl:Restriction ; owl:onClass c:CMPE-C0001 ; owl:onProperty [ owl:inverseOf r:CMPE-R0001 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A context-dependent role borne by a person, group, or organizational entity that has an interest or responsibility in the enterprise." ; skos:prefLabel "Organizational Stakeholder" ; meta:additionalDomain d:CMPE-D0002 ; meta:primaryDomain d:CMPE-D0001 ; meta:status "active" ; meta:stereotype meta:Role .
c:CMPE-C0001 a owl:Class ; dcterms:identifier "CMPE-C0001" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0038 ; owl:onProperty [ owl:inverseOf r:CMPE-R0033 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onClass c:CMPE-C0014 ; owl:onProperty r:CMPE-R0040 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "An organizational entity that participates in and coordinates pharmaceutical ecosystem activities, capabilities, resources, partnerships, and governance." ; skos:prefLabel "Pharmaceutical Enterprise" ; meta:additionalDomain d:CMPE-D0002 ; meta:primaryDomain d:CMPE-D0001 ; meta:status "active" ; meta:stereotype meta:Kind .
