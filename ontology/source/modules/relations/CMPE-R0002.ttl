r:CMPE-R0002 a owl:ObjectProperty ; dcterms:identifier "CMPE-R0002" ; rdfs:domain c:CMPE-C0003 ; rdfs:range c:CMPE-C0025 ; skos:definition "CM-PharmE relation connecting instances of Organizational Stakeholder to instances of Enterprise Governance Relator; canonical label “is mediated by” and relation stereotype “mediation”." ; skos:prefLabel "is mediated by" ; meta:cardinalityStatus "resolved-from-relator-occurrence" ; meta:relationStereotype meta:Mediation ; meta:reviewNote "Two graphical occurrences conflict because Enterprise Governance Relator was duplicated as relator and mode. The occurrence attached to the canonical relator node is authoritative for B3 cardinality." ; meta:sourceEndMultiplicity "1..*" ; meta:status "active" ; meta:targetEndMultiplicity "1" .
