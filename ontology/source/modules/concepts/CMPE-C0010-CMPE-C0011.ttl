c:CMPE-C0010 a owl:Class ; dcterms:identifier "CMPE-C0010" ; skos:definition "A mode representing an observable or represented indication of demand within the pharmaceutical ecosystem." ; skos:prefLabel "Ecosystem Demand Signal" ; meta:primaryDomain d:CMPE-D0002 ; meta:status "active" ; meta:stereotype meta:Mode .
c:CMPE-C0011 a owl:Class ; dcterms:identifier "CMPE-C0011" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0008 ; owl:onProperty [ owl:inverseOf r:CMPE-R0009 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A mode representing the capacity of an ecosystem actor or arrangement to supply products, services, or capabilities." ; skos:prefLabel "Ecosystem Supply Capacity" ; meta:primaryDomain d:CMPE-D0002 ; meta:status "active" ; meta:stereotype meta:Mode .
