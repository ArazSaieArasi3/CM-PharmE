c:CMPE-C0016 a owl:Class ; dcterms:identifier "CMPE-C0016" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0015 ; owl:onProperty r:CMPE-R0013 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onClass c:CMPE-C0030 ; owl:onProperty [ owl:inverseOf r:CMPE-R0038 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A perdurant representing an ordered sequence of clinical activities carried out within a healthcare or pharmaceutical process." ; skos:prefLabel "Clinical Activity Sequence" ; meta:primaryDomain d:CMPE-D0003 ; meta:status "active" ; meta:stereotype meta:Perdurant .
