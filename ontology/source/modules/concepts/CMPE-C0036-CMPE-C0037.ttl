c:CMPE-C0036 a owl:Class ; dcterms:identifier "CMPE-C0036" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0038 ; owl:onProperty [ owl:inverseOf r:CMPE-R0032 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A normative requirement specifying obligations for monitoring, assessing, reporting, or managing medicine safety." ; skos:prefLabel "Pharmacovigilance Requirement" ; meta:additionalDomain d:CMPE-D0003 ; meta:primaryDomain d:CMPE-D0004 ; meta:status "active" ; meta:stereotype meta:Mode .
