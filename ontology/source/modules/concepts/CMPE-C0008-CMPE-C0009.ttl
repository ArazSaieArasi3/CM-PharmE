c:CMPE-C0008 a owl:Class ; dcterms:identifier "CMPE-C0008" ; rdfs:subClassOf [ a owl:Restriction ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass c:CMPE-C0009 ; owl:onProperty r:CMPE-R0007 ], [ a owl:Restriction ; owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass c:CMPE-C0014 ; owl:onProperty r:CMPE-R0027 ] ; skos:definition "A role borne by an entity that participates in the pharmaceutical ecosystem and its inter-organizational relationships." ; skos:prefLabel "Ecosystem Actor" ; meta:primaryDomain d:CMPE-D0002 ; meta:status "active" ; meta:stereotype meta:Role .
c:CMPE-C0009 a owl:Class ; dcterms:identifier "CMPE-C0009" ; rdfs:subClassOf [ a owl:Restriction ; owl:onClass c:CMPE-C0013 ; owl:onProperty r:CMPE-R0036 ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ], [ a owl:Restriction ; owl:onClass c:CMPE-C0008 ; owl:onProperty [ owl:inverseOf r:CMPE-R0007 ] ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ; skos:definition "A relator that connects ecosystem actors through a structured inter-organizational relationship." ; skos:prefLabel "Ecosystem Relationship" ; meta:primaryDomain d:CMPE-D0002 ; meta:status "active" ; meta:stereotype meta:Relator .
